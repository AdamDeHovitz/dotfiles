{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git mv:*)",
      "Bash(git init:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh auth:*)",
      "Bash(gh workflow:*)",
      "Bash(gh search:*)",
      "Bash(mv:*)",
      "Bash(docker logs:*)",
      "Bash(docker pull:*)",
      "Bash(kubectl describe:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$PPID; while [ \"$p\" -gt 1 ]; do t=$(ps -o tty= -p $p | tr -d \" \"); case $t in \"\"|\"??\") p=$(ps -o ppid= -p $p | tr -d \" \");; *) printf \"\\a\" > /dev/$t; exit 0;; esac; done"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "p=$PPID; while [ \"$p\" -gt 1 ]; do t=$(ps -o tty= -p $p | tr -d \" \"); case $t in \"\"|\"??\") p=$(ps -o ppid= -p $p | tr -d \" \");; *) printf \"\\a\" > /dev/$t; exit 0;; esac; done"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "linear-cli@linear-cli": true,
    "linear@claude-plugins-official": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "tui": "fullscreen",
  "editorMode": "normal",
  "skipAutoPermissionPrompt": true
}
